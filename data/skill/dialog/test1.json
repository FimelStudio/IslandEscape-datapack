{
    "pause": false,
    "title": {
        "text": "编辑感染体属性",
        "color": "red"
    },
    "body": [
        {
            "type": "plain_message",
            "contents": [
                {
                    "type": "object",
                    "object": "player",
                    "player": {}
                },
                {
                    "text": "当前感染者：",
                    "color": "white"
                },
                {
                    "storage": "zombie:eated",
                    "nbt": "player_name"
                }
            ]
        }
    ],
    "inputs": [
        {
            "key": "out_text",
            "type": "text",
            "label": {
                "text": "请输入一些文本",
                "color": "blue"
            },
            "label_visible": true,
            "max_length": 64,
            "multiline": {
                "max_lines": 10
            }
        },
        {
            "type": "minecraft:number_range",
            "label": "更改感染体血量(影响速度和体型)",
            "key": "config_health",
            "start": 5,
            "end": 35,
            "step": 1,
            "initial": 20
        }
    ],
    "type": "confirmation",
    "no": {
        "label": {
            "text": "取消编辑",
            "color": "white"
        },
        "tooltip": {
            "text": "点击退出"
        }
    },
    "yes": {
        "label": {
            "text": "确定编辑",
            "color": "dark_red"
        },
        "tooltip": {
            "text": "点击确定"
        },
        "action": {
            "type": "dynamic/run_command",
            "template": "tellraw @a {text:\"$(config_health)\"}"
        }
    }
}