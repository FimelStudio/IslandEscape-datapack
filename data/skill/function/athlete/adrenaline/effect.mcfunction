execute if score #speed_amp skill.adren_cfg matches 0 run effect give @s minecraft:speed 1 0 true
execute if score #speed_amp skill.adren_cfg matches 1 run effect give @s minecraft:speed 1 1 true
execute if score #speed_amp skill.adren_cfg matches 2 run effect give @s minecraft:speed 1 2 true
execute if score #speed_amp skill.adren_cfg matches 3 run effect give @s minecraft:speed 1 3 true
execute if score #speed_amp skill.adren_cfg matches 4.. run effect give @s minecraft:speed 1 4 true
