                                    "text": " chu_feng_breeze",
                                    "color": "white"
                                }
                            ]
                        },
                        {
                            "type": "minecraft:plain_message",
                            "contents": {
                                "text": "游戏背景",
                                "color": "gray"
                            },
                            "width": 480
                        },
                        {
                            "type": "minecraft:plain_message",
                            "contents": {
                                "text": "最危险的不是已经暴露的感染体，而是潜伏在人群中的母体。它看起来仍像普通幸存者，却能在夜色、混乱和不信任中扩散感染。",
                                "color": "dark_red"
                            },
                            "width": 480
                        },
                        {
                            "type": "minecraft:plain_message",
                            "contents": {
                                "text": "岛上仍有信号塔、发电机、船只、实验室和撤离设施。幸存者必须抢时间完成任务；感染阵营则要拖慢、分割并最终转化所有人。",
                                "color": "gray"
                            },
                            "width": 480
                        }
                    ],
                    "can_close_with_escape": true,
                    "action": {
                        "label": {
                            "text": "返回菜单",
                            "color": "green"
                        },
                        "action": {
                            "type": "minecraft:show_dialog",
                            "dialog": "escape_island:menu"
                        }
                    }
                }
            }
        },
        {
            "label": "游戏玩法",
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": {
                    "type": "minecraft:notice",
                    "pause": false,
                    "title": {
                        "text": "      游戏玩法",
                        "color": "aqua",
                        "bold": true
                    },
                    "body": [
                        {
                            "type": "minecraft:plain_message",
                            "contents": {
                                "text": "幸存者目标：探索岛屿、搜集物资、修复关键设施，并通过直升机、船只、潜艇或其他路线撤离。",
                                "color": "gray"
                            },
                            "width": 480
                        },
                        {
                            "type": "minecraft:plain_message",
                            "contents": {
                                "text": "感染阵营目标：母体保持身份隐藏，利用冲刺、感知、吞噬和孢子召唤制造减员；普通感染体负责追击、压迫和破坏任务节奏。",
                                "color": "dark_red"
                            },
                            "width": 480
                        },
                        {
                            "type": "minecraft:plain_message",
                            "contents": {
                                "text": "核心规则：感染不是一次命中立刻转化，而是先积累孢子污染。污染叠满后进入感染期，若未及时处理，玩家会转化为普通感染体。",
                                "color": "yellow"
                            },
                            "width": 480
                        },
                        {
                            "type": "minecraft:plain_message",
                            "contents": {
                                "text": "行动建议：不要长期单走；发现队友失踪、路线异常或任务点被拖慢时，优先汇报位置和状态。杀死母体只能争取时间，完成撤离才是主要胜利路径。",
                                "color": "gray"
                            },
                            "width": 480
                        }
                    ],
                    "can_close_with_escape": true,
                    "action": {
                        "label": {
                            "text": "返回菜单",
                            "color": "green"
                        },
                        "action": {
                            "type": "minecraft:show_dialog",
                            "dialog": "escape_island:menu"
                        }
                    }
                }
            }
        },
        {
            "label": "身份介绍",
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "escape_island:profession/pfs_menu"
