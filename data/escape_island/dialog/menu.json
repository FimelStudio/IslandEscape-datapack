                                "\n\n",
                                {
                                    "text": "【特别感谢】\n",
                                    "color": "gold"
                                },
                                "",
                                {
                                    "text": "616789\nDomnick_JYH\nlawyer112 \u00a7e(服务器支持)\n\u00a7b00ɹɐəlϽ \u00a7e(战利品表)\u00a7b\nLateTea\nWemsur\n残月sama\n墨安",
                                    "color": "aqua"
                                },
                                "\n\n",
                                {
                                    "text": "【建筑师团队】\n",
                                    "color": "gold"
                                },
                                {
                                    "text": "616789\nDomnick_JYH\nlawyer112 \u00a7e(协助烫手的山芋地图#1)\u00a7b\nBadt_i_m_e \u00a77(早期)\n\u00a7bmelon_444 \u00a77(早期)\u00a7b\nCreatorLizard \u00a77(早期)\u00a7b\nSR_AJ67 \u00a77(早期)\u00a7b\nthework \u00a77(早期)\u00a7b\n毒岛渡鸦丶 \u00a77(有偿)\u00a7b\n\u00a77... ...",
                                    "color": "aqua"
                                },
                                "\n\n",
                                {
                                    "text": "【测试团队】\n",
                                    "color": "gold"
                                },
                                {
                                    "text": "wifi_left (wifi_right)\n616789\nlawyer112\nDomnick_JYH\n\u00a77...\n\u00a7a以及支持 MiniGames 的小伙伴们！~",
                                    "color": "aqua"
                                }
                            ]
                        }
                    ],
                    "pause": false,
                    "after_action": "close",
                    "action": {
                        "label": "返回",
                        "action": {
                            "type": "show_dialog",
                            "dialog": "escape_island:menu"
                        }
                    }
                }
            }
        },
        {
            "label": "身份介绍",
            "action": {
                "type": "show_dialog",
                "dialog": "escape_island:profession/pfs_menu"
            }
        },
        {
            "label": "游戏设置",
            "action": {
                "type": "show_dialog",
                "dialog": {
                    "columns": 1,
                    "pause": false,
                    "type": "minecraft:multi_action",
                    "title": "地图背景音乐设置",
                    "body": [
                        {
                            "type": "minecraft:plain_message",
                            "contents": [
                                {
                                    "text": "启用或者禁用地图音乐。\n您也可以关闭声音选项中的"
                                },
                                {
                                    "translate": "soundCategory.voice"
                                },
                                {
                                    "text": "来调整音乐声音大小。"
                                }
                            ]
                        }
                    ],
                    "actions": [
                        {
                            "label": {
                                "text": "启用地图背景音乐",
                                "color": "green"
                            },
                            "action": {
                                "type": "run_command",
                                "command": "say 1"
                            }
                        },
                        {
                            "label": {
                                "text": "禁用地图背景音乐",
                                "color": "red"
                            },
                            "action": {
                                "type": "run_command",
                                "command": "say 1"
                            }
                        },
                        {
                            "label": "返回",
                            "action": {
                                "type": "show_dialog",
                                "dialog": "escape_island:menu"
                            }
                        }
                    ],
                    "exit_action": {
                        "label": "关闭"
                    }
                }
            }
        },
        {
            "label": "返回大厅",
            "action": {
                "type": "minecraft:run_command",
                "command": "tellraw @a {text:\"yes\"}"
            }
        }
    ],
    "exit_action": {
        "label": "关闭"
    }
}