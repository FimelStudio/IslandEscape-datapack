                                    "color": "aqua"
                                },
                                {
                                    "text": "LISENCE",
                                    "color": "green",
                                    "underlined": true,
                                    "click_event": {
                                        "action": "open_url",
                                        "url": "https://github.com/wifi-left/Map-MiniGames/blob/master/LISENCE"
                                    }
                                },
                                {
                                    "text": " 找到。\n",
