        "text": "快捷菜单",
        "color": "yellow"
    },
    "body": [
        {
            "type": "minecraft:plain_message",
            "contents": [
                {
                    "text": "欢迎游玩 ",
                    "color": "aqua"
                },
                {
                    "text": "海岛",
                    "color": "dark_red"
                },
                {
                    "text": "逃生 ",
                    "color": "dark_aqua"
                },
                {
                    "text": "Island ",
                    "color": "dark_red"
                },
                {
                    "text": "Escape",
                    "color": "dark_aqua"
                },
                {
                    "text": "\n"
                }
            ]
        }
    ],
    "columns": 1,
    "actions": [
        {
            "label": "地图介绍",
            "action": {
